<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClipVault.Views.AboutPage"
             Title="Sobre o ClipVault"
             BackgroundColor="#18181B">

    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="24" MaximumWidthRequest="480">
        <Border BackgroundColor="#202024"
                StrokeShape="RoundRectangle 16"
                Stroke="#2E2E33"
                Padding="28"
                WidthRequest="420">
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                <!-- Logotipo / Ícone -->
                <Border BackgroundColor="#6366F1"
                        StrokeShape="RoundRectangle 24"
                        Stroke="Transparent"
                        HeightRequest="72"
                        WidthRequest="72"
                        HorizontalOptions="Center">
                    <Label Text="📋"
                           FontSize="36"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Nome e Versão -->
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="ClipVault"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#F4F4F5"
                           HorizontalTextAlignment="Center" />
                    <Border BackgroundColor="#27272A"
                            StrokeShape="RoundRectangle 6"
                            Stroke="#3F3F46"
                            Padding="8,2"
                            HorizontalOptions="Center">
                        <Label Text="Versão 1.1.1"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#818CF8" />
                    </Border>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#2E2E33" Margin="0,4" />

                <!-- Detalhes do Criador e Data -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                        <Label Text="Criador" FontSize="11" TextColor="#71717A" />
                        <Label Text="Filipe R. Carvalho" FontSize="13" FontAttributes="Bold" TextColor="#E4E4E7" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                        <Label Text="Data de Lançamento" FontSize="11" TextColor="#71717A" />
                        <Label Text="Outubro de 2026" FontSize="13" FontAttributes="Bold" TextColor="#E4E4E7" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                        <Label Text="Repositório Oficial" FontSize="11" TextColor="#71717A" />
                        <Label Text="github.com/filiperamosc/ClipVault"
                               FontSize="12"
                               TextColor="#38BDF8" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="#2E2E33" Margin="0,4" />

                <Label Text="Aplicativo portátil de alta performance para monitoramento inteligente da área de transferência com OCR nativo Windows, visão computacional ONNX e SQLite local."
                       FontSize="11"
                       TextColor="#A1A1AA"
                       HorizontalTextAlignment="Center" />

                <!-- Botão Voltar -->
                <Button Text="Fechar"
                        Clicked="OnCloseClicked"
                        BackgroundColor="#27272A"
                        TextColor="#F4F4F5"
                        CornerRadius="8"
                        HeightRequest="36"
                        FontAttributes="Bold"
                        FontSize="12"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
