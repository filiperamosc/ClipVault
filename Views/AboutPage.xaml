<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClipVault.Views.AboutPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F0F12">

    <Grid RowDefinitions="Auto,*" Padding="16,12" RowSpacing="12">

        <!-- Barra Superior Compacta (Fluent Design Windows 11) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Button Text="&#xE72B;"
                        FontFamily="Segoe Fluent Icons"
                        ToolTipProperties.Text="Voltar"
                        Clicked="OnBackClicked"
                        BackgroundColor="#18181C"
                        BorderColor="#27272E"
                        BorderWidth="1"
                        TextColor="#E4E4E7"
                        FontSize="13"
                        CornerRadius="8"
                        WidthRequest="34"
                        HeightRequest="32"
                        MinimumWidthRequest="0"
                        MinimumHeightRequest="0"
                        Padding="0" />

                <Label Text="&#xE946;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="15"
                       TextColor="#818CF8"
                       VerticalOptions="Center" />
                <Label Text="Sobre"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#F4F4F6"
                       VerticalOptions="Center" />
                <Label Text="•" TextColor="#3F3F46" VerticalOptions="Center" />
                <Label Text="Informações do Sistema"
                       FontSize="11.5"
                       TextColor="#71717A"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Conteúdo do Cartão Sobre -->
        <ScrollView Grid.Row="1" VerticalOptions="Center">
            <Grid HorizontalOptions="Center" Padding="12" MaximumWidthRequest="460">
                <Border BackgroundColor="#18181C"
                        StrokeShape="RoundRectangle 8"
                        Stroke="#26262E"
                        Padding="28"
                        WidthRequest="410">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                        <!-- Ícone Fluent -->
                        <Border BackgroundColor="#6366F1"
                                StrokeShape="RoundRectangle 16"
                                Stroke="Transparent"
                                HeightRequest="64"
                                WidthRequest="64"
                                HorizontalOptions="Center">
                            <Label Text="&#xE8C8;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="28"
                                   TextColor="#FFFFFF"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Nome e Versão -->
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="ClipVault"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#F4F4F6"
                                   HorizontalTextAlignment="Center" />
                            <Border BackgroundColor="#23232B"
                                    StrokeShape="RoundRectangle 6"
                                    Stroke="#32323D"
                                    Padding="10,3"
                                    HorizontalOptions="Center">
                                <Label Text="Versão 1.5.1"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#818CF8" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#26262E" Margin="0,4" />

                        <!-- Detalhes do Criador e Data -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="Autor" FontSize="11" TextColor="#71717A" />
                                <Label Text="Filipe R. Carvalho" FontSize="12.5" FontAttributes="Bold" TextColor="#E4E4E7" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                <Label Text="Lançamento" FontSize="11" TextColor="#71717A" />
                                <Label Text="Outubro de 2026" FontSize="12.5" FontAttributes="Bold" TextColor="#E4E4E7" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                <Label Text="Repositório Oficial" FontSize="11" TextColor="#71717A" />
                                <Label Text="github.com/filiperamosc/ClipVault"
                                       FontSize="12"
                                       TextColor="#38BDF8"
                                       TextDecorations="Underline">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRepositoryUrlTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#26262E" Margin="0,4" />

                        <Label Text="Gerenciador portátil de área de transferência para Windows com reconhecimento óptico de caracteres (OCR), classificação visual ONNX e banco de dados SQLite local."
                               FontSize="11.5"
                               TextColor="#9CA3AF"
                               HorizontalTextAlignment="Center" />

                        <!-- Botão Fechar -->
                        <Button Text="Fechar"
                                Clicked="OnCloseClicked"
                                BackgroundColor="#23232B"
                                TextColor="#F4F4F6"
                                CornerRadius="8"
                                HeightRequest="36"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                FontAttributes="Bold"
                                FontSize="12"
                                Margin="0,6,0,0" />

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
