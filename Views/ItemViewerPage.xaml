<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClipVault.ViewModels"
             x:Class="ClipVault.Views.ItemViewerPage"
             x:DataType="vm:ClipboardItemViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F0F12">

    <Grid RowDefinitions="Auto,*" Padding="16,12" RowSpacing="10">

        <!-- Barra Superior / Cabeçalho -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Button Text="&#xE72B;"
                        FontFamily="Segoe Fluent Icons"
                        ToolTipProperties.Text="Voltar"
                        Clicked="OnBackClicked"
                        BackgroundColor="#18181C"
                        BorderColor="#27272E"
                        BorderWidth="1"
                        TextColor="#E4E4E7"
                        FontSize="13"
                        CornerRadius="8"
                        WidthRequest="34"
                        HeightRequest="32"
                        MinimumWidthRequest="0"
                        MinimumHeightRequest="0"
                        Padding="0" />

                <Label Text="{Binding TypeIcon}"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="15"
                       TextColor="#818CF8"
                       VerticalOptions="Center" />
                <Label Text="{Binding TypeDisplayName}"
                       FontSize="13.5"
                       FontAttributes="Bold"
                       TextColor="#F4F4F6"
                       VerticalOptions="Center" />
                <Label Text="•" TextColor="#3F3F46" VerticalOptions="Center" />
                <Label Text="{Binding FormattedDate}"
                       FontSize="11.5"
                       TextColor="#9CA3AF"
                       VerticalOptions="Center" />
                <Label Text="•" TextColor="#3F3F46" VerticalOptions="Center" />
                <Label Text="{Binding FormattedSize}"
                       FontSize="11.5"
                       TextColor="#9CA3AF"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                <Button Text="Copiar Conteúdo"
                        Clicked="OnCopyContentClicked"
                        BackgroundColor="#6366F1"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="11.5"
                        CornerRadius="8"
                        HeightRequest="32"
                        MinimumHeightRequest="0"
                        MinimumWidthRequest="0"
                        Padding="14,0" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1">

            <!-- 1. MODO VISUALIZADOR DE IMAGEM -->
            <Grid IsVisible="{Binding IsImage}" RowDefinitions="*,Auto" RowSpacing="8">

                <!-- Área Interativa da Imagem com Zoom e Pan -->
                <Border Grid.Row="0"
                        BackgroundColor="#18181C"
                        StrokeShape="RoundRectangle 8"
                        Stroke="#26262E"
                        Padding="6">
                    <Grid>
                        <ContentView x:Name="ImageContainer" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <ContentView.GestureRecognizers>
                                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                            </ContentView.GestureRecognizers>
                            <Image x:Name="TargetImage"
                                   Source="{Binding FilePath}"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </ContentView>

                        <!-- Controles de Zoom Fluent -->
                        <HorizontalStackLayout HorizontalOptions="End"
                                               VerticalOptions="Start"
                                               Spacing="6"
                                               Margin="10"
                                               ZIndex="10">
                            <Button Text="&#xE8A3;"
                                    FontFamily="Segoe Fluent Icons"
                                    ToolTipProperties.Text="Aumentar Zoom"
                                    Clicked="OnZoomInClicked"
                                    BackgroundColor="#D918181C"
                                    BorderColor="#27272E"
                                    BorderWidth="1"
                                    TextColor="#F4F4F6"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    FontSize="13"
                                    Padding="0" />
                            <Button Text="&#xE71F;"
                                    FontFamily="Segoe Fluent Icons"
                                    ToolTipProperties.Text="Diminuir Zoom"
                                    Clicked="OnZoomOutClicked"
                                    BackgroundColor="#D918181C"
                                    BorderColor="#27272E"
                                    BorderWidth="1"
                                    TextColor="#F4F4F6"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    FontSize="13"
                                    Padding="0" />
                            <Button Text="100%"
                                    ToolTipProperties.Text="Redefinir Zoom"
                                    Clicked="OnResetZoomClicked"
                                    BackgroundColor="#D918181C"
                                    BorderColor="#27272E"
                                    BorderWidth="1"
                                    TextColor="#38BDF8"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    Padding="10,0" />
                            <Button Text="&#xE8B7;"
                                    FontFamily="Segoe Fluent Icons"
                                    ToolTipProperties.Text="Localizar arquivo no Explorer"
                                    Clicked="OnOpenExplorerClicked"
                                    BackgroundColor="#D918181C"
                                    BorderColor="#27272E"
                                    BorderWidth="1"
                                    TextColor="#E4E4E7"
                                    FontSize="13"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    Padding="0" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Painel Inferior de Metadados (Categorias e OCR) -->
                <VerticalStackLayout Grid.Row="1" Spacing="6">
                    <!-- Tags de Classificação Visual -->
                    <Border IsVisible="{Binding HasImageTags}"
                            BackgroundColor="#18181C"
                            StrokeShape="RoundRectangle 8"
                            Stroke="#312E81"
                            Padding="12,8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="&#xE8EC;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="12"
                                   TextColor="#818CF8"
                                   VerticalOptions="Center" />
                            <Label Text="Classificação Visual:"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#818CF8"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding ImageTags}"
                                   FontSize="11.5"
                                   TextColor="#E0E7FF"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Texto Extraído via OCR -->
                    <Border IsVisible="{Binding HasExtractedText}"
                            BackgroundColor="#18181C"
                            StrokeShape="RoundRectangle 8"
                            Stroke="#1E3A5F"
                            Padding="12,8">
                        <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="&#xE890;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="12"
                                           TextColor="#38BDF8"
                                           VerticalOptions="Center" />
                                    <Label Text="Texto Reconhecido (OCR):"
                                           FontSize="11.5"
                                           FontAttributes="Bold"
                                           TextColor="#38BDF8"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Copiar OCR"
                                        Clicked="OnCopyOcrClicked"
                                        BackgroundColor="#0284C7"
                                        TextColor="#FFFFFF"
                                        FontSize="10.5"
                                        CornerRadius="6"
                                        HeightRequest="26"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        Padding="10,0" />
                            </Grid>
                            <ScrollView Grid.Row="1" MaximumHeightRequest="110">
                                <Label Text="{Binding ExtractedText}"
                                       FontSize="11.5"
                                       TextColor="#F0F9FF"
                                       LineBreakMode="WordWrap" />
                            </ScrollView>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- 2. MODO VISUALIZADOR DE TEXTO / CÓDIGO / URL -->
            <Border IsVisible="{Binding IsText}"
                    BackgroundColor="#18181C"
                    StrokeShape="RoundRectangle 8"
                    Stroke="#26262E"
                    Padding="16">
                <Grid RowDefinitions="*,Auto" RowSpacing="12">
                    <ScrollView Grid.Row="0">
                        <Editor Text="{Binding Content}"
                                IsReadOnly="True"
                                TextColor="#F4F4F6"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"
                                FontSize="13" />
                    </ScrollView>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label x:Name="TextStatsLabel"
                               FontSize="11"
                               TextColor="#71717A"
                               VerticalOptions="Center" />
                        <Button x:Name="OpenBrowserButton"
                                Grid.Column="1"
                                Text="Abrir no Navegador"
                                Clicked="OnOpenBrowserClicked"
                                IsVisible="False"
                                BackgroundColor="#23232B"
                                TextColor="#38BDF8"
                                FontSize="11.5"
                                CornerRadius="8"
                                HeightRequest="30"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                Padding="12,0" />
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>

</ContentPage>
