<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClipVault.ViewModels"
             x:Class="ClipVault.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             SizeChanged="OnPageSizeChanged"
             BackgroundColor="#0F0F12">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Toast / Feedback Visual Minimalista -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsToastVisible}"
                BackgroundColor="#1E293B"
                StrokeShape="RoundRectangle 8"
                Stroke="#334155"
                Margin="16,8,16,0"
                Padding="14,6"
                HorizontalOptions="Center"
                ZIndex="100">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="&#xE73E;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="12"
                       TextColor="#38BDF8"
                       VerticalOptions="Center" />
                <Label Text="{Binding ToastMessage}"
                       TextColor="#F8FAFC"
                       FontSize="12"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Cabeçalho Unificado Fluent Design (Busca + Filtros + Ações Rápidas) -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Padding="16,12,16,8" RowSpacing="10">

            <!-- Linha 1: Barra de Pesquisa + Botões de Ferramentas Discretos -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">

                <!-- Campo de Busca Fluent -->
                <Border Grid.Column="0"
                        BackgroundColor="#18181C"
                        StrokeShape="RoundRectangle 8"
                        Stroke="#27272E"
                        HeightRequest="36"
                        Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13"
                               TextColor="#71717A"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText, Mode=TwoWay}"
                               Placeholder="Pesquisar textos, reconhecimento óptico (OCR), categorias ou datas..."
                               PlaceholderColor="#71717A"
                               TextColor="#F4F4F6"
                               BackgroundColor="Transparent"
                               FontSize="12.5"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Ações da Barra Superior (Ícones Fluent Minimalistas) -->
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">

                    <!-- Alternar Modo Lista / Grade -->
                    <Button Text="{Binding ViewModeIcon}"
                            FontFamily="Segoe Fluent Icons"
                            ToolTipProperties.Text="{Binding ViewModeTooltip}"
                            Command="{Binding ToggleViewModeCommand}"
                            BackgroundColor="#18181C"
                            BorderColor="#27272E"
                            BorderWidth="1"
                            TextColor="#E4E4E7"
                            CornerRadius="8"
                            WidthRequest="36"
                            HeightRequest="36"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            FontSize="14"
                            Padding="0" />

                    <!-- Limpar Histórico -->
                    <Button Text="&#xE74D;"
                            FontFamily="Segoe Fluent Icons"
                            ToolTipProperties.Text="Limpar histórico (mantém fixados)"
                            Command="{Binding ClearHistoryCommand}"
                            BackgroundColor="#18181C"
                            BorderColor="#27272E"
                            BorderWidth="1"
                            TextColor="#F87171"
                            CornerRadius="8"
                            WidthRequest="36"
                            HeightRequest="36"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            FontSize="14"
                            Padding="0" />

                    <!-- Sobre -->
                    <Button Text="&#xE946;"
                            FontFamily="Segoe Fluent Icons"
                            ToolTipProperties.Text="Sobre o ClipVault"
                            Clicked="OnAboutClicked"
                            BackgroundColor="#18181C"
                            BorderColor="#27272E"
                            BorderWidth="1"
                            TextColor="#9CA3AF"
                            CornerRadius="8"
                            WidthRequest="36"
                            HeightRequest="36"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            FontSize="14"
                            Padding="0" />

                    <!-- Configurações -->
                    <Button Text="&#xE713;"
                            FontFamily="Segoe Fluent Icons"
                            ToolTipProperties.Text="Configurações"
                            Clicked="OnSettingsClicked"
                            BackgroundColor="#6366F1"
                            TextColor="#FFFFFF"
                            CornerRadius="8"
                            WidthRequest="36"
                            HeightRequest="36"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            FontSize="14"
                            Padding="0" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Linha 2: Pílulas de Filtro + Indicador de Status -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Button Text="Todos"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Todos"
                            BackgroundColor="{Binding FilterTodosBg}"
                            TextColor="{Binding FilterTodosFg}"
                            CornerRadius="8"
                            HeightRequest="28"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            Padding="12,0"
                            FontSize="11.5" />

                    <Button Text="Textos"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Textos"
                            BackgroundColor="{Binding FilterTextosBg}"
                            TextColor="{Binding FilterTextosFg}"
                            CornerRadius="8"
                            HeightRequest="28"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            Padding="12,0"
                            FontSize="11.5" />

                    <Button Text="Imagens"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Imagens"
                            BackgroundColor="{Binding FilterImagensBg}"
                            TextColor="{Binding FilterImagensFg}"
                            CornerRadius="8"
                            HeightRequest="28"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            Padding="12,0"
                            FontSize="11.5" />

                    <Button Text="Fixados"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Fixados"
                            BackgroundColor="{Binding FilterFixadosBg}"
                            TextColor="{Binding FilterFixadosFg}"
                            CornerRadius="8"
                            HeightRequest="28"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            Padding="12,0"
                            FontSize="11.5" />
                </HorizontalStackLayout>

                <!-- Indicador Discreto de Status -->
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <BoxView WidthRequest="6"
                             HeightRequest="6"
                             CornerRadius="3"
                             Color="#10B981"
                             VerticalOptions="Center" />
                    <Label Text="{Binding StatusSubtitle}"
                           FontSize="11"
                           TextColor="#71717A"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!-- Área Principal de Conteúdo -->
        <Grid Grid.Row="2" Margin="16,2,16,8">

            <!-- 1. MODO LISTA (CLEAN FLUENT LIST) -->
            <CollectionView ItemsSource="{Binding ListItemsSource}"
                            IsVisible="{Binding IsListView}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="10"
                                         Margin="0,60,0,0">
                        <Label Text="&#xE8C8;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="32"
                               TextColor="#3F3F46"
                               HorizontalOptions="Center" />
                        <Label Text="Nenhum item encontrado"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#A1A1AA"
                               HorizontalOptions="Center" />
                        <Label Text="Copie textos ou capture imagens para registrá-los automaticamente."
                               FontSize="12"
                               TextColor="#71717A"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                        <Border BackgroundColor="#18181C"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#26262E"
                                Padding="12,8"
                                Margin="0,0,0,2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenItemViewerCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="24,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">

                                <!-- Cabeçalho do Item -->
                                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="7" VerticalOptions="Center">
                                    <Label Text="{Binding TypeIcon}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="12"
                                           TextColor="#818CF8"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding TypeDisplayName}"
                                           FontSize="11.5"
                                           FontAttributes="Bold"
                                           TextColor="#E4E4E7"
                                           VerticalOptions="Center" />
                                    <Label Text="•" TextColor="#3F3F46" VerticalOptions="Center" />
                                    <Label Text="{Binding FormattedDate}"
                                           FontSize="11"
                                           TextColor="#71717A"
                                           VerticalOptions="Center" />
                                    <Label Text="•" TextColor="#3F3F46" VerticalOptions="Center" />
                                    <Label Text="{Binding FormattedSize}"
                                           FontSize="11"
                                           TextColor="#71717A"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- Botões de Ação Compactos (Somente Ícones) -->
                                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Button Text="&#xE8C8;"
                                            FontFamily="Segoe Fluent Icons"
                                            ToolTipProperties.Text="Copiar"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=CopyItemCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#23232B"
                                            TextColor="#E4E4E7"
                                            FontSize="12"
                                            CornerRadius="6"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            MinimumWidthRequest="0"
                                            MinimumHeightRequest="0"
                                            Padding="0" />

                                    <Button Text="{Binding PinIcon}"
                                            FontFamily="Segoe Fluent Icons"
                                            ToolTipProperties.Text="{Binding PinText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=TogglePinCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#23232B"
                                            TextColor="{Binding PinIconColor}"
                                            FontSize="12"
                                            CornerRadius="6"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            MinimumWidthRequest="0"
                                            MinimumHeightRequest="0"
                                            Padding="0" />

                                    <Button Text="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons"
                                            ToolTipProperties.Text="Excluir"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DeleteItemCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#23232B"
                                            TextColor="#F87171"
                                            FontSize="12"
                                            CornerRadius="6"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            MinimumWidthRequest="0"
                                            MinimumHeightRequest="0"
                                            Padding="0" />
                                </HorizontalStackLayout>

                                <!-- Corpo do Item -->
                                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                    <Label Text="{Binding PreviewText, FallbackValue='', TargetNullValue=''}"
                                           IsVisible="{Binding IsText}"
                                           TextColor="#D4D4D8"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                    <Grid IsVisible="{Binding IsImage}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border StrokeShape="RoundRectangle 6"
                                                Stroke="#27272E"
                                                BackgroundColor="#121215"
                                                Padding="2"
                                                VerticalOptions="Start">
                                            <Image Source="{Binding SafeImageSource, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                                                   HeightRequest="84"
                                                   WidthRequest="130"
                                                   Aspect="AspectFit" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                            <Border IsVisible="{Binding HasImageTags}"
                                                    BackgroundColor="#1E1E2A"
                                                    StrokeShape="RoundRectangle 6"
                                                    Stroke="#312E81"
                                                    Padding="8,3"
                                                    HorizontalOptions="Start">
                                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                    <Label Text="&#xE8EC;"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="10"
                                                           TextColor="#818CF8"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{Binding SafeImageTags, FallbackValue='', TargetNullValue=''}"
                                                           FontSize="11"
                                                           TextColor="#C7D2FE"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>

                                            <Border IsVisible="{Binding HasExtractedText}"
                                                    BackgroundColor="#142029"
                                                    StrokeShape="RoundRectangle 6"
                                                    Stroke="#1E3A5F"
                                                    Padding="8,3"
                                                    HorizontalOptions="Start">
                                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                    <Label Text="&#xE890;"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="10"
                                                           TextColor="#38BDF8"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{Binding OcrPreview, FallbackValue='', TargetNullValue=''}"
                                                           FontSize="11"
                                                           TextColor="#BAE6FD"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 2. MODO GRADE (PROPORÇÃO PERFEITA: RowDefinitions="22,*,36") -->
            <CollectionView ItemsSource="{Binding GridItemsSource}"
                            IsVisible="{Binding IsGridView}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{Binding GridSpan}"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="10"
                                         Margin="0,60,0,0">
                        <Label Text="&#xF0E2;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="32"
                               TextColor="#3F3F46"
                               HorizontalOptions="Center" />
                        <Label Text="Nenhum item para exibir na grade"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#A1A1AA"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                        <Border BackgroundColor="#18181C"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#26262E"
                                Padding="10"
                                HeightRequest="220">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenItemViewerCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <!-- Linha 0: 22px (Cabeçalho) | Linha 1: * (Conteúdo Principal) | Linha 2: 36px (Barra de Ações Compacta) -->
                            <Grid RowDefinitions="22,*,36" RowSpacing="6">

                                <!-- Linha 0: Metadados Superiores -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding TypeIcon, FallbackValue='&#xE8A5;', TargetNullValue='&#xE8A5;'}"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="11"
                                               TextColor="#818CF8"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding TypeDisplayName, FallbackValue='Texto', TargetNullValue='Texto'}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#E4E4E7"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="{Binding FormattedDate, FallbackValue='', TargetNullValue=''}"
                                           FontSize="10"
                                           TextColor="#71717A"
                                           VerticalOptions="Center" />
                                </Grid>

                                <!-- Linha 1 (*): Conteúdo Principal Absorvendo o Espaço Máximo -->
                                <Grid Grid.Row="1">
                                    <!-- Preview de Texto -->
                                    <Border IsVisible="{Binding IsText}"
                                            BackgroundColor="#121215"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="#222228"
                                            Padding="8">
                                        <Label Text="{Binding PreviewText, FallbackValue='', TargetNullValue=''}"
                                               TextColor="#D4D4D8"
                                               FontSize="11.5"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="6" />
                                    </Border>

                                    <!-- Preview de Imagem -->
                                    <Border IsVisible="{Binding IsImage}"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="#222228"
                                            BackgroundColor="#121215"
                                            Padding="2">
                                        <Grid>
                                            <Image Source="{Binding SafeImageSource, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                                                   Aspect="AspectFit"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />

                                            <!-- Pílula discreta de Tags sobreposta no canto inferior esquerdo da imagem -->
                                            <Border IsVisible="{Binding HasImageTags}"
                                                    BackgroundColor="#D918181C"
                                                    StrokeShape="RoundRectangle 4"
                                                    Stroke="#312E81"
                                                    Padding="6,2"
                                                    Margin="4"
                                                    VerticalOptions="End"
                                                    HorizontalOptions="Start">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Label Text="&#xE8EC;"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="9"
                                                           TextColor="#818CF8"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{Binding SafeImageTags, FallbackValue='', TargetNullValue=''}"
                                                           FontSize="9.5"
                                                           TextColor="#C7D2FE"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Linha 2 (Height="36"): Rodapé Compacto com Botões Exclusivamente de Ícone -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalOptions="Center">

                                    <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding FormattedSize, FallbackValue='0 B', TargetNullValue='0 B'}"
                                               FontSize="10"
                                               TextColor="#71717A"
                                               VerticalOptions="Center" />
                                        <Border IsVisible="{Binding HasExtractedText}"
                                                BackgroundColor="#142029"
                                                StrokeShape="RoundRectangle 4"
                                                Stroke="#1E3A5F"
                                                Padding="5,1"
                                                VerticalOptions="Center">
                                            <Label Text="OCR"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="#38BDF8"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Button Text="&#xE8C8;"
                                                FontFamily="Segoe Fluent Icons"
                                                ToolTipProperties.Text="Copiar"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=CopyItemCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#6366F1"
                                                TextColor="#FFFFFF"
                                                FontSize="12"
                                                CornerRadius="6"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                MinimumWidthRequest="0"
                                                MinimumHeightRequest="0"
                                                Padding="0" />

                                        <Button Text="{Binding PinIcon, FallbackValue='&#xE718;', TargetNullValue='&#xE718;'}"
                                                FontFamily="Segoe Fluent Icons"
                                                ToolTipProperties.Text="{Binding PinText, FallbackValue='Fixar', TargetNullValue='Fixar'}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=TogglePinCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#23232B"
                                                TextColor="{Binding PinIconColor, FallbackValue='#A1A1AA', TargetNullValue='#A1A1AA'}"
                                                FontSize="12"
                                                CornerRadius="6"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                MinimumWidthRequest="0"
                                                MinimumHeightRequest="0"
                                                Padding="0" />

                                        <Button Text="&#xE74D;"
                                                FontFamily="Segoe Fluent Icons"
                                                ToolTipProperties.Text="Excluir"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DeleteItemCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#23232B"
                                                TextColor="#F87171"
                                                FontSize="12"
                                                CornerRadius="6"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                MinimumWidthRequest="0"
                                                MinimumHeightRequest="0"
                                                Padding="0" />
                                    </HorizontalStackLayout>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- Rodapé Discreto -->
        <Border Grid.Row="3"
                BackgroundColor="#121216"
                Stroke="#1F1F26"
                Padding="16,5">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="ClipVault v1.5.1 • Monitoramento de Área de Transferência"
                       FontSize="10.5"
                       TextColor="#71717A"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Execução em segundo plano na bandeja do sistema"
                       FontSize="10.5"
                       TextColor="#71717A"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
