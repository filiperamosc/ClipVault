<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClipVault.ViewModels"
             x:Class="ClipVault.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#18181B">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Notificação Toast / Feedback Visual -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsToastVisible}"
                BackgroundColor="#22C55E"
                StrokeShape="RoundRectangle 8"
                Stroke="Transparent"
                Margin="16,8,16,0"
                Padding="12,8"
                HorizontalOptions="Center"
                ZIndex="100">
            <Label Text="{Binding ToastMessage}"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </Border>

        <!-- Barra Superior / Header -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="20,16,20,8">
            <VerticalStackLayout Spacing="2">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="ClipVault"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#F4F4F5" />
                    <Border BackgroundColor="#27272A"
                            StrokeShape="RoundRectangle 6"
                            Stroke="#3F3F46"
                            Padding="8,2">
                        <Label Text="{Binding StatusSubtitle}"
                               FontSize="11"
                               TextColor="#A1A1AA"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                <!-- Botão Pausar/Retomar -->
                <Button Text="{Binding IsMonitoringPaused, Converter={x:Null}, StringFormat='⏯️'}"
                        ToolTipProperties.Text="Pausar ou Retomar Monitoramento"
                        Command="{Binding ToggleMonitoringCommand}"
                        BackgroundColor="#27272A"
                        TextColor="#E4E4E7"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="10,0" />

                <!-- Botão Limpar Histórico -->
                <Button Text="🗑️ Limpar"
                        ToolTipProperties.Text="Limpar itens não fixados"
                        Command="{Binding ClearHistoryCommand}"
                        BackgroundColor="#27272A"
                        TextColor="#EF4444"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="12,0" />

                <!-- Botão Configurações -->
                <Button Text="⚙️ Configurações"
                        Clicked="OnSettingsClicked"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="12,0" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Barra de Pesquisa e Filtros -->
        <VerticalStackLayout Grid.Row="2" Padding="20,4,20,12" Spacing="10">
            <!-- Campo de Busca -->
            <Border BackgroundColor="#27272A"
                    StrokeShape="RoundRectangle 10"
                    Stroke="#3F3F46"
                    Padding="12,0">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="🔍"
                           FontSize="14"
                           TextColor="#A1A1AA"
                           VerticalOptions="Center"
                           Margin="0,0,8,0" />
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           Placeholder="Pesquisar por palavra-chave, código ou data (ex: 18/10)..."
                           PlaceholderColor="#71717A"
                           TextColor="#FAFAFA"
                           BackgroundColor="Transparent"
                           HeightRequest="40" />
                </Grid>
            </Border>

            <!-- Abas / Filtros Rápidos -->
            <HorizontalStackLayout Spacing="8">
                <Button Text="Todos"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Todos"
                        BackgroundColor="#3F3F46"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="32"
                        Padding="16,0"
                        FontSize="12" />

                <Button Text="📝 Textos"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Textos"
                        BackgroundColor="#27272A"
                        TextColor="#D4D4D8"
                        CornerRadius="8"
                        HeightRequest="32"
                        Padding="14,0"
                        FontSize="12" />

                <Button Text="🖼️ Imagens"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Imagens"
                        BackgroundColor="#27272A"
                        TextColor="#D4D4D8"
                        CornerRadius="8"
                        HeightRequest="32"
                        Padding="14,0"
                        FontSize="12" />

                <Button Text="📌 Fixados"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Fixados"
                        BackgroundColor="#27272A"
                        TextColor="#FBBF24"
                        CornerRadius="8"
                        HeightRequest="32"
                        Padding="14,0"
                        FontSize="12" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Lista de Itens Capturados (Virtualizada) -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Items}"
                        Margin="20,0,20,10">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Margin="0,60,0,0">
                    <Label Text="📋"
                           FontSize="44"
                           HorizontalOptions="Center" />
                    <Label Text="Nenhum item encontrado no histórico"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#A1A1AA"
                           HorizontalOptions="Center" />
                    <Label Text="Copie qualquer texto ou tire um print (Print Screen) para salvar automaticamente."
                           FontSize="13"
                           TextColor="#71717A"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                    <Border BackgroundColor="#202024"
                            StrokeShape="RoundRectangle 12"
                            Stroke="#2E2E33"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">

                            <!-- Cabeçalho do Card: Tipo, Data, Tamanho e Indicador de Fixado -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding TypeIcon}" FontSize="14" VerticalOptions="Center" />
                                <Label Text="{Binding Type}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#6366F1"
                                       VerticalOptions="Center" />
                                <Label Text="•" TextColor="#52525B" VerticalOptions="Center" />
                                <Label Text="{Binding FormattedDate}"
                                       FontSize="11"
                                       TextColor="#71717A"
                                       VerticalOptions="Center" />
                                <Label Text="•" TextColor="#52525B" VerticalOptions="Center" />
                                <Label Text="{Binding FormattedSize}"
                                       FontSize="11"
                                       TextColor="#71717A"
                                       VerticalOptions="Center" />

                                <Label Text="📌 FIXADO"
                                       IsVisible="{Binding IsPinned}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#F59E0B"
                                       VerticalOptions="Center"
                                       Margin="6,0,0,0" />
                            </HorizontalStackLayout>

                            <!-- Ações Rápidas (Copiar, Fixar, Excluir) -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Button Text="📋 Copiar"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=CopyItemCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#4F46E5"
                                        TextColor="White"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="6"
                                        HeightRequest="28"
                                        Padding="10,0" />

                                <Button Text="{Binding PinIcon}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=TogglePinCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#27272A"
                                        TextColor="#F4F4F5"
                                        FontSize="12"
                                        CornerRadius="6"
                                        HeightRequest="28"
                                        Padding="8,0" />

                                <Button Text="🗑️"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DeleteItemCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#27272A"
                                        TextColor="#EF4444"
                                        FontSize="12"
                                        CornerRadius="6"
                                        HeightRequest="28"
                                        Padding="8,0" />
                            </HorizontalStackLayout>

                            <!-- Conteúdo: Visualização de Texto / Imagem -->
                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                                <!-- Texto / Código / URL -->
                                <Label Text="{Binding PreviewText}"
                                       IsVisible="{Binding IsText}"
                                       TextColor="#E4E4E7"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="4" />

                                <!-- Imagem / Print Screen -->
                                <Border IsVisible="{Binding IsImage}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#2E2E33"
                                        BackgroundColor="#141416"
                                        Padding="4"
                                        HorizontalOptions="Start">
                                    <Image Source="{Binding FilePath}"
                                           MaximumHeightRequest="180"
                                           Aspect="AspectFit" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Barra Inferior / Rodapé -->
        <Border Grid.Row="4"
                BackgroundColor="#121214"
                Stroke="#27272A"
                Padding="20,8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="ClipVault • Operando em segundo plano na bandeja do sistema"
                       FontSize="11"
                       TextColor="#71717A"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Fechar a janela minimiza para a bandeja"
                       FontSize="11"
                       TextColor="#71717A"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
